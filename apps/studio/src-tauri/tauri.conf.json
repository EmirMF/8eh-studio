{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8EH Studio",
  "version": "0.1.0",
  "identifier": "com.eighteh.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "8EH Studio",
        "width": 560,
        "height": 680,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
