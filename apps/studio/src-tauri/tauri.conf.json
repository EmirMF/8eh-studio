{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8EH Studio",
  "version": "0.1.0",
  "identifier": "com.eighteh.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "8EH Studio",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/ffmpeg.exe": "ffmpeg.exe",
      "binaries/FFmpeg-LICENSE.txt": "FFmpeg-LICENSE.txt",
      "binaries/FFmpeg-README.txt": "FFmpeg-README.txt",
      "binaries/FFmpeg-SOURCE.txt": "FFmpeg-SOURCE.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
