{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8EH Companion",
  "version": "0.1.0",
  "identifier": "com.eighteh.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "8EH Companion",
        "width": 400,
        "height": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
